# Copy this file to .env and fill in the values. Never commit .env.

# --- AI ---
# Which AI to use: gemini or claude. Fill in the key for the one you pick.
AI_PROVIDER=gemini

# Gemini (free tier): get a key at https://aistudio.google.com  (click "Get API key")
# Free tier: Google may use what you send to improve its products -> test with MOCK documents only.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Claude: get a key at https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=
# Cheaper/faster while testing. Try claude-sonnet-5-5 for the final demo.
CLAUDE_MODEL=claude-haiku-5-5

# Set to 1 to force fake answers (no key needed). The app also does this automatically
# when the key for AI_PROVIDER is empty.
MOCK_AI=0

# --- App ---
PORT=8000
# Accounts: any long random text. Keeps people signed in when the app restarts.
# Make one with:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
# Below this confidence (0-1), Dalil refuses to guess and points to the official service
MIN_CONFIDENCE=0.6
