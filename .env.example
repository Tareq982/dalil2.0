# Copy this file to .env and fill in the values. Never commit .env.

# --- AI (Claude) ---
# Get a key at https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=
# Cheaper/faster while testing. Try claude-sonnet-5-5 for the final demo.
CLAUDE_MODEL=claude-haiku-5-5

# Set to 1 to run without an API key (returns a fake result, for UI/WhatsApp work)
MOCK_AI=0

# --- WhatsApp via Twilio sandbox (only the Channels person needs these) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# The sandbox number shown in Twilio > Messaging > Try it out > Send a WhatsApp message
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# --- App ---
PORT=8000
# Below this confidence (0-1), Dalil refuses to guess and points to the official service
MIN_CONFIDENCE=0.6
